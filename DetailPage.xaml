<?xml version="1.0" encoding="utf-8" ?>

<!-- Color palette: https://colorhunt.co/palette/f5fbe6215e61233d4dfe7f2d
	F5FBE6
	215E61
	233D4D
	E8E2DB -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductivityApp.DetailPage"
			 BackgroundColor="#233D4D"
             Title="DetailPage">
	
    <VerticalStackLayout>
		
		<Grid
			Padding="10"
			ColumnSpacing="10"
			RowSpacing="10"
			VerticalOptions="Start">

			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border
				Grid.Row="0"
				Grid.Column="0"
				HeightRequest="150"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="2"
				Background="#215E61"
				Stroke="#F5FBE6">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Label
						Text="{Binding Goal.Name}"
						Padding="10,10"
						FontSize="18"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						Grid.Row="0" />

					<Label
						Text="{Binding Goal.TargetDate}"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="End"
						Grid.Row="0" />

					<Label
						Text="{Binding Goal.Motivation}"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						Grid.Row="1"/>

					<ProgressBar
						Progress="{Binding Goal.Progress}"
						ProgressColor="#FE7F2D"
						BackgroundColor="#233D4D"
						Grid.Row="2"/>

				</Grid>

			</Border>

			<Button
				Grid.Row="2"
				Text="Back"
				FontSize="24"
				FontAttributes="Bold"
				TextColor="#FE7F2D"
				BackgroundColor="#F5FBE6" 
				Clicked="OnBackButtonClicked"/>

		</Grid>
    </VerticalStackLayout>
</ContentPage>