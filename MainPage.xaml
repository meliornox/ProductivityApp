<?xml version="1.0" encoding="utf-8" ?>
<!-- Color palette: https://colorhunt.co/palette/f5fbe6215e61233d4dfe7f2d
	F5FBE6
	215E61
	233D4D
	E8E2DB -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductivityApp.MainPage"
			 BackgroundColor="#233D4D">

    <ScrollView>
		<Grid
			Padding="10"
			ColumnSpacing="10"
			RowSpacing="10"
			VerticalOptions="Start">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			
			<Grid
				Padding="10"
				ColumnSpacing="10"
				RowSpacing="10"
				VerticalOptions="Start">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Label
					Grid.Row="0"
					Grid.Column="0"
					Text="Let's Get Started!"
					HorizontalTextAlignment="Start"
					VerticalTextAlignment="Center"
					Padding="10,10"
					FontAttributes="Bold"
					FontSize="18"
					TextColor="#FE7F2D" />

				<Border
					Grid.Row="1"
					Grid.Column="0"
					HeightRequest="150"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="2"
					Background="#215E61"
					Stroke="#F5FBE6">
					<Label
						Text="First Goal"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						VerticalTextAlignment="Start" />
				</Border>
			
				<Border
					Grid.Row="1"
					Grid.Column="1"
					HeightRequest="150"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="2"
					Background="#215E61"
					Stroke="#F5FBE6">
					<Label
						Text="Second Goal"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						VerticalTextAlignment="Start" />
				</Border>

				<Border
					Grid.Row="2"
					Grid.Column="0"
					HeightRequest="150"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="2"
					Background="#215E61"
					Stroke="#F5FBE6">
					<Label
						Text="Third Goal"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						VerticalTextAlignment="Start" />
				</Border>

				<Border
					Grid.Row="2"
					Grid.Column="1"
					HeightRequest="150"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="2"
					Background ="#215E61"
					Stroke="#F5FBE6">
					<Label
						Text="Fourth Goal"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						VerticalTextAlignment="Start" />
				</Border>

				<Border
					Grid.Row="3"
					Grid.Column="0"
					HeightRequest="150"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="2"
					Background="#215E61"
					Stroke="#F5FBE6">
					<Label
						Text="Fifth Goal"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						VerticalTextAlignment="Start" />
				</Border>

				<Border
					Grid.Row="3"
					Grid.Column="1"
					HeightRequest="150"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="2"
					Background ="#215E61"
					Stroke="#F5FBE6">
					<Label
						Text="Sixth Goal"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						VerticalTextAlignment="Start" />
					
				</Border>
			</Grid>
			
			<Button 
				Grid.Row="1" 
				Text="New Goal" 
				TextColor="#FE7F2D"
				BackgroundColor="#F5FBE6" />
			
		</Grid>
    </ScrollView>
</ContentPage>
