<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductivityApp.NewGoalPage"
			 BackgroundColor="#233D4D"
             Title="New Goal">
	
    <VerticalStackLayout>
		
		<Grid
			Padding="10"
			ColumnSpacing="10"
			RowSpacing="10"
			VerticalOptions="Start">
			
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border
				Grid.Row="0"
				Grid.Column="0"
				HeightRequest="150"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="2"
				Background="#215E61"
				Stroke="#F5FBE6">
				
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					
					<Label
						Text="First Goal"
						Padding="10,10"
						FontSize="18"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						Grid.Row="0" />
					
					<Label
						Text="February 18th, 2026"
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="End"
						Grid.Row="0" />
					
					<Label
						Text="The first goal is important."
						Padding="10,10"
						FontSize="14"
						TextColor="#FE7F2D"
						HorizontalTextAlignment="Start"
						Grid.Row="1"/>
					
					<ProgressBar
						Progress="0.3"
						ProgressColor="#FE7F2D"
						BackgroundColor="#233D4D"
						Grid.Row="2"/>
				</Grid>
			</Border>

			<Button
				Grid.Row="1"
				Text="Add"
				FontSize="24"
				FontAttributes="Bold"
				TextColor="#FE7F2D"
				BackgroundColor="#F5FBE6"
                Clicked="OnSubmitButtonClicked"/>

			<Button
				Grid.Row="2"
				Text="Back"
				FontSize="24"
				FontAttributes="Bold"
				TextColor="#FE7F2D"
				BackgroundColor="#F5FBE6"
				Clicked="OnBackButtonClicked"/>

		</Grid>
    </VerticalStackLayout>
</ContentPage>